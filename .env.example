# MCPC local configuration template
# VITE_* is read by Vite. Export MCPC_* in the shell before building the Rust core.
# The .example API host is reserved and intentionally does not resolve.
# Replace it with your own HTTPS backend host ending in /v2.
MCPC_API_BASE_URL=https://api.mcpc.example/v2
VITE_MCPC_API_BASE_URL=https://api.mcpc.example/v2

# Required to enable Microsoft sign-in; use an MCPC-owned Entra application.
MCPC_MS_CLIENT_ID=

# Optional; set in the shell before compiling the Rust core, using an MCPC-owned Discord application.
MCPC_DISCORD_APP_ID=

# Automatic updates stay disabled until an MCPC-signed feed is configured.
VITE_MCPC_UPDATES_ENABLED=false

# Optional comma-separated MCPC-owned voice relay hostnames; blank disables party voice.
MCPC_VOICE_RELAY_DOMAINS=

# Optional MCPC-owned HTTPS deep-link/Discord join-page URL prefix; blank disables the join button.
MCPC_JOIN_URL_PREFIX=
